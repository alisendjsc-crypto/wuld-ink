# wuld.ink .gitignore
# Deploy artifacts (Cloudflare Pages now pulls from main branch)
*.zip
*.tar.gz
wuld-ink-deploy*
ziCwRmw0
ziGq6fkD
zi[A-Za-z0-9]*

# Editor / IDE
.vscode/
.idea/
*.swp
*~
*.bak

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Node (in case build tooling ever lands)
node_modules/
.env
.env.local

# Cowork session artifacts (none currently expected, but defensive)
outputs/

# Audio conversion staging — MP3s land here mid-session for R2 upload.
# Never ship to git; audio is hosted on audio.wuld.ink (R2 bucket wuld-audio).
_audio-staging/

# Procmon traces — multi-GB binary; analyzed Josiah-side via procmon-parser
# Python script (scripts/analyze_procmon.py). Never ship raw .pml to git.
*.pml
*.PML
docs/Procmon-*.pml
docs/Procmon-*.PML

# Procmon CSV outputs from analyze_procmon.py — analysis artifacts, kept
# Josiah-side for forensic reference but not part of wuld.ink repo.
k*-trace.csv
docs/k*-trace.csv

# Library publication artifacts (K17+ landed Josiah-side from library-Claude
# coordination session output). These belong in the library GitHub repo
# (alisendjsc-crypto/efilist-argument-library), NOT wuld.ink. Staged here
# only because Josiah's working folder is shared. Deferred to dedicated
# library publication coordination session per K17 lock.
docs/LICENSE
docs/LICENSE-CODE
docs/README.md
docs/CITATION_cff_*.cff
docs/RELEASE_NOTES_v*.md
docs/OPERATOR_CHECKLIST_*.md
docs/cowork_orientation_v*.md
docs/library_claude_coordination_EXCHANGE_*_FRAGMENT.md

images/

# Python bytecache (tools/, etc.)
__pycache__/
*.pyc

# Wrangler CLI cache (created by `wrangler r2 object put` / dev at repo root)
.wrangler/
# Staging bay for strays awaiting operator deletion. device_bash cannot
# rm on a mounted path, so a session moves dead files here and Josiah
# empties it. Ignored so the bay itself never becomes the untracked noise
# it exists to clear (K288).
_to_delete/

# Inbox for handoffs from the Video Editing project (docs/wuld_ink_handoff_dot.md
# names it). That project regenerates and re-syncs this folder on its own schedule
# -- three times in ninety minutes on the day it landed -- and every session here
# gates verify-at-open on a clean `git status`, so a folder a DIFFERENT project
# rewrites makes that gate unreliable: a session opens, sees dirt, and has to work
# out whose it is. Same reasoning as _to_delete/ above. The HANDOUT stays tracked
# because it is static; the buffer does not because it is live. Nothing is lost --
# the canonical copies live in the Video Editing project and Downloads\dot_release\,
# and whatever the site PUBLISHES lands in src/ under version control (K293e).
docs/dot-handoff/

# K310: "outputs/" never matched a directory with a space in the name; 2.3 MB of .mp4
# sat untracked-but-not-ignored in the repo root, one `git add -A` from the history.
Claude outputs/
